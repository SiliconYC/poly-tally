{
  "datasetEpoch": "source-only-lineage-2026-10-21-v1",
  "lineageGroups": [
    {
      "id": "vitro",
      "members": [
        "SiliconYC/vitro",
        "SiliconYC/vitro_zero_lab",
        "SiliconYC/vitro_union_lab"
      ]
    }
  ],
  "owners": [
    "SiliconYC"
  ],
  "repositories": {
    "include": [
      "SiliconYC/*"
    ],
    "exclude": []
  },
  "rules": {
    "include_forks": false,
    "max_blob_bytes": 2000000,
    "include": [
      "**"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/vendor/**",
      "**/third_party/**",
      "**/third-party/**",
      "**/site-packages/**",
      "**/.git/**",
      "**/.venv/**",
      "**/venv/**",
      "**/__pycache__/**",
      "**/[Dd]ist/**",
      "**/[Bb]uild/**",
      "**/Intermediate/**",
      "**/coverage/**",
      "**/.next/**",
      "**/target/**",
      "**/.cache/**",
      "**/.pytest_cache/**",
      "**/.mypy_cache/**",
      "**/.ruff_cache/**",
      "**/.vite/**",
      "**/.yarn/**",
      "**/.pnpm-store/**",
      "**/.claude/**",
      "**/.superpowers/**",
      "**/docs/superpowers/**",
      "**/.obsidian/plugins/**",
      "**/.obsidian/themes/**",
      "**/.obsidian/workspace*.json",
      "**/.env",
      "**/.env.*",
      "**/.DS_Store",
      "**/*.tmp",
      "**/*.temp",
      "**/*.bak",
      "**/*.pyc",
      "**/*.pyo",
      "**/*.swp",
      "**/*.swo",
      "**/_temp/**",
      "**/.trash/**",
      "**/recycle/**",
      "**/*.log",
      "**/*.log.*",
      "**/*.gen.cpp",
      "**/*.generated.h",
      "**/*.generated.cpp",
      "**/*.min.js",
      "**/*.min.css",
      "**/*.map",
      "**/package-lock.json",
      "**/pnpm-lock.yaml",
      "**/yarn.lock",
      "**/uv.lock",
      "**/poetry.lock",
      "**/Cargo.lock",
      "**/composer.lock",
      "**/web/data/**",
      "**/site/data/**",
      "**/.cm/stat/**",
      "**/.cm/模组信息.json",
      "**/tally-state/**"
    ],
    "languages": {},
    "artifact_exclude": [
      "**/*日志.json",
      "**/*缓存.json",
      "**/*历史记录.json",
      "**/*历史记录字典.json",
      "**/debug-output.json",
      "**/trace.json",
      "**/capture.json",
      "**/performance.json",
      "**/*-performance.json",
      "**/*-report.json",
      "**/results/*.json",
      "**/results/*.txt",
      "**/results/*.html",
      "**/results/*.svg",
      "**/reports/*.json",
      "**/reports/*.txt",
      "**/reports/*.html",
      "**/reports/*.svg",
      "**/derived/*.json",
      "**/derived/*.txt",
      "**/derived/*.html",
      "**/derived/*.svg",
      "**/.cm/项目更新日志.json",
      "**/[Ll]og/*.json",
      "**/[Ll]og/*.txt",
      "**/[Ll]og/*.md",
      "**/[Ll]og/*.html",
      "**/[Ll]og/*.yaml",
      "**/[Ll]og/*.yml",
      "**/[Ll]og/*.xml",
      "**/[Ll]ogs/*.json",
      "**/[Ll]ogs/*.txt",
      "**/[Ll]ogs/*.md",
      "**/[Ll]ogs/*.html",
      "**/[Ll]ogs/*.yaml",
      "**/[Ll]ogs/*.yml",
      "**/[Ll]ogs/*.xml",
      "**/L_log/*.json",
      "**/L_log/*.txt",
      "**/L_log/*.md",
      "**/L_log/*.html",
      "**/L_log/*.yaml",
      "**/L_log/*.yml",
      "**/L_log/*.xml",
      "**/运行日志/*.json",
      "**/运行日志/*.txt",
      "**/运行日志/*.md",
      "**/运行日志/*.html",
      "**/运行日志/*.yaml",
      "**/运行日志/*.yml",
      "**/运行日志/*.xml",
      "**/调试输出/*.json",
      "**/调试输出/*.txt",
      "**/调试输出/*.md",
      "**/调试输出/*.html",
      "**/调试输出/*.yaml",
      "**/调试输出/*.yml",
      "**/调试输出/*.xml"
    ],
    "source_preserve": [
      "**/src/**",
      "**/source/**",
      "**/tests/**",
      "**/test/**",
      "**/fixtures/**",
      "**/README.*",
      "**/readme.*",
      "**/[Dd]ocs/*.md",
      "**/[Dd]ocs/*.mdx",
      "**/[Dd]ocs/*.rst",
      "**/[Dd]ocs/*.txt",
      "**/[Dd]ocs/*.tex",
      "**/*文档/*.md",
      "**/*文档/*.mdx",
      "**/*文档/*.rst",
      "**/*文档/*.txt",
      "**/*文档/*.tex"
    ],
    "exclude_extensions": [
      ".json",
      ".jsonc",
      ".yaml",
      ".yml",
      ".xml"
    ],
    "exclude_languages": [
      "JSON",
      "YAML",
      "XML"
    ]
  }
}
